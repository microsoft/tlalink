<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tlalink</ToolCommandName>
    <PackageId>TlaLink</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Microsoft</Authors>
    <Description>Local C# source/model correspondence and explicit formal-analysis evidence using Roslyn, TLA+, Dafny and P.</Description>
    <PackageTags>formal-methods;roslyn;tla;dafny</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/microsoft/tlalink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildSDKsPath)\..\..\..\LICENSE.txt" Pack="true" PackagePath="licenses\dotnet-sdk-LICENSE.txt" />
    <None Include="$(MSBuildSDKsPath)\..\..\..\ThirdPartyNotices.txt" Pack="true" PackagePath="licenses\dotnet-sdk-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\java-toolchain.json" LogicalName="TlaLink.java-toolchain.json" />
    <EmbeddedResource Include="..\..\analysis-toolchain.json" LogicalName="TlaLink.analysis-toolchain.json" />
    <EmbeddedResource Include="..\..\native-toolchain.json" LogicalName="TlaLink.native-toolchain.json" />
    <None Include="..\..\NuGet.Config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="NuGet.Config" />
    <Compile Remove="Dafny\DafnyIndex.source.cs" />
    <Compile Remove="PLang\PIndex.source.cs" />
    <EmbeddedResource Include="PLang\PIndex.source.cs" LogicalName="TlaLink.PIndex.source.cs" />
    <None Include="PLang\PIndex.source.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="PIndex.source.cs" />
    <None Include="Dafny\DafnyIndex.source.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="DafnyIndex.source.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" />
    <None Update="Tla\TlaIndex.java" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="TlaIndex.java" />
    <None Include="Common\Runtime\TraceRuntime.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="TraceRuntime.source.cs" />
  </ItemGroup>
</Project>
